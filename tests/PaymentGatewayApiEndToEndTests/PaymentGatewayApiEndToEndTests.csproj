<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- no reference to the api project: the suite owns its request shape and reads raw JSON,
       so a renamed property on the api side fails here instead of changing on both sides -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
