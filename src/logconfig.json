{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff}] [{Level:u3}] TraceId={TraceId}, {Message}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "z-logs/info-.log",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] CallerId={CallerId:l}, TraceId={TraceId}, SpanId={SpanId}, {Message}, Source={SourceContext}{NewLine}",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "z-logs/error-.log",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] CallerId={CallerId:l}, TraceId={TraceId}, SpanId={SpanId}, {Message}, Source={SourceContext}{NewLine}Exception={Exception}{NewLine}",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}