{
  "request": {
    "method": "POST",
    "url": "/payments",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.card_number", "matches": "^.*0$" } },
      { "matchesJsonPath": { "expression": "$.expiry_date", "matches": "^(0[1-9]|1[0-2])/[0-9]{4}$" } },
      { "matchesJsonPath": "$.currency" },
      { "matchesJsonPath": "$.amount" },
      { "matchesJsonPath": "$.cvv" }
    ]
  },
  "response": {
    "status": 503,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {}
  }
}
