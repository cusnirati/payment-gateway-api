{
  "request": {
    "method": "POST",
    "url": "/payments",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.card_number", "matches": "^.*[2468]$" } },
      { "matchesJsonPath": "$.expiry_date" },
      { "matchesJsonPath": "$.currency" },
      { "matchesJsonPath": "$.amount" },
      { "matchesJsonPath": "$.cvv" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "authorized": false, "reason": "insufficient funds" }
  }
}
