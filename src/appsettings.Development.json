{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "WriteTo": {
      "Console": {
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Display.MessageTemplateTextFormatter, Serilog",
            "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {CorrelationId} {Message:l}{NewLine}{Exception}"
          }
        }
      },
      "InfoFile": {
        "Name": "File",
        "Args": {
          "path": "z-logs/info-.log",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] CorrelationId={CorrelationId}, TraceId={TraceId}, Message={Message:l}, Source={SourceContext}{NewLine}{Exception}",
          "rollingInterval": "Day"
        }
      },
      "ErrorFile": {
        "Name": "File",
        "Args": {
          "path": "z-logs/error-.log",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] CorrelationId={CorrelationId}, TraceId={TraceId}, Message={Message:l}, Source={SourceContext}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    }
  },
  "ApiKeys": {
    "Merchants": [
      { "MerchantId": "merchant-a", "KeySha256": "c8c3a5a56d9ba1bff80c60a7d11478525838e0bef3d728fc4185aa3da1b84015" },
      { "MerchantId": "merchant-b", "KeySha256": "eb56dcd8cc40c7452f90e58fb83f526c4985c56cd51633ebe3f40131f0d1dd41" }
    ]
  },
  "Bank": {
    "BaseUrl": "http://localhost:8080/"
  },
  "AWS": {
    "ServiceURL": "http://localhost:8000"
  }
}
